{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "DefaultConnection": "Server=localhost;Database=mvpmaker;User=root;Password=password;"
  },
  "Jwt": {
    "SecretKey": "your-super-secret-key-min-32-characters-long-for-security-please-change-in-production",
    "Issuer": "MvpMakerApi",
    "Audience": "MvpMakerApiClient",
    "ExpirationMinutes": "60"
  },
  "Kestrel": {
    "Endpoints": {
      "Http": {
        "Url": "http://0.0.0.0:8080"
      }
    }
  },
  "GitHub": {
    "ApiBaseUrl": "https://api.github.com",
    "UserAgent": "MvpMakerApi/1.0"
  },
  "Stripe": {
    "SecretKey": "${STRIPE_SECRET_KEY}",
    "PublishableKey": "${STRIPE_PUBLISHABLE_KEY}",
    "WebhookSecret": "${STRIPE_WEBHOOK_SECRET}",
    "SuccessUrl": "http://localhost:3000/payment/success?session_id={CHECKOUT_SESSION_ID}",
    "CancelUrl": "http://localhost:3000/payment/cancel"
  },
  "Encryption": {
    "Key": "${Encryption__Key}"
  }
}
